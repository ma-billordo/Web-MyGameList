package views

import (
    "fmt"
    "MyGameList.com/db/sqlc"
)

func userErrorID(id int32) string {
    return fmt.Sprintf("user-error-%d", id)
}

templ UserList(users []db.ListUsersRow) {
    <div id="user-list">
        <p class="empty-message">Todavía no hay usuarios registrados. ¡Registrate en el formulario y sé el primero!</p>
        for _, user := range users {
            <article>
                <h4>{ user.Name }</h4>
                <p>{ user.Email }</p>
                <button
                    hx-delete={ fmt.Sprintf("/users/%d", user.IDUser) }
                    hx-target="closest article"
                    hx-swap="outerHTML"
                    hx-confirm="¿Seguro que querés borrar este usuario?"
                    hx-status:404={ "target:#" + userErrorID(user.IDUser) + " swap:innerHTML" }
                    hx-status:500={ "target:#" + userErrorID(user.IDUser) + " swap:innerHTML" }>
                    Borrar
                </button>
                <div id={ userErrorID(user.IDUser) }></div>
            </article>
        }
    </div>
}