package views

import (
    "fmt"
    "MyGameList.com/db/sqlc"
)
func gameErrorID(id int32) string {
    return fmt.Sprintf("game-error-%d", id)
}

templ LibraryList(games []db.Library) {
    <div id="library-list">
        <p class="empty-message">Todavía no hay juegos cargados. ¡Agregá el primero con el formulario!</p>
        for _, game := range games {
            <article>
                <h4>{ game.Title }</h4>
                <p>{ game.Description }</p>
                <button
                    hx-delete={ fmt.Sprintf("/library/%d", game.IDGame) }
                    hx-target="closest article"
                    hx-swap="outerHTML"
                    hx-confirm="¿Seguro que querés borrar este juego?"
                    hx-status:404={ "target:#" + gameErrorID(game.IDGame) + " swap:innerHTML" }
                    hx-status:500={ "target:#" + gameErrorID(game.IDGame) + " swap:innerHTML" }>
                    Borrar
                </button>
                <div id={ gameErrorID(game.IDGame) }></div>
            </article>
        }
    </div>
}