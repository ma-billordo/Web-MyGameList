package views

import (
    "fmt"
    "MyGameList.com/db/sqlc"
)

templ IndexPage(users []db.UserInfo) {
    @Layout("MyGameList") {
        <section class="bienvenida">
                <h1>MyGameList 🎮</h1>
                <h2 class="titulo">¡Bienvenidos!</h2>
                <p>En esta página podrás llevar un registro de tus juegos favoritos, con su estado y tu puntuación</p>
        </section>

        <p class="acciones">¿Qué querés hacer primero?</p>
        <article class="acciones">
            <h3>🕹️ Juegos</h3>
            <p>Cargá juegos</p>
            <a href="/library" role="button">Crear juego</a>
        </article>

        <article class="acciones">
            <h3>👤 Usuarios</h3>
            <p>Registrate con un usuario</p>
            <a href="/users" role="button">Crear usuario</a>
        </article>

        <article class="acciones">
            <h3>⭐ Catálogo</h3>
            <p>Registrá el estado y puntuacion de un juego</p>
            
            if len(users) == 0 {
                <p>Aún no hay usuarios cargados. <a href="/users">Creá el primero.</a></p>
            } else {
                <form action="/catalogue" method="get">
                    <label for="user">Usuario</label>
                    <select id="user" name="user" required>
                        <option value="" disabled selected>Elegí un usuario</option>
                        for _, u := range users {
                            <option value={ fmt.Sprint(u.IDUser) }>{ u.Name + " (" + u.Email + ")" }</option>
                        }
                    </select>
                    <button type="submit">Ir al catálogo</button>
                </form>
            }
        </article>
    }
}